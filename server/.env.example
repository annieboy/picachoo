# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/picachoo

# Encryption key for OAuth tokens (32 bytes hex = 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace_with_64_char_hex_string

# Google OAuth 2.0
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match the Authorized Redirect URI set in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# CORS
CLIENT_ORIGIN=http://localhost:5173
